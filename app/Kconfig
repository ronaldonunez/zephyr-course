menuconfig LED_SUBSYSTEM
	bool "LED subsystem"
	default n
	help
	  Light emitter diode subsystem

if LED_SUBSYSTEM

choice 
	prompt "LED blink sleep time"
	default LED_TIME_1000_MS

config LED_TIME_250_MS
	bool "Fast (250ms)"

config LED_TIME_1000_MS
	bool "Medium (1s)"

config LED_TIME_2000_MS
	bool "Slow (2s)"
endchoice

config BLINK_SLEEP_TIME_MS
	int # No prompt --> hidden
	default 250 if LED_TIME_250_MS
	default 1000 if LED_TIME_1000_MS
	default 2000 if LED_TIME_2000_MS
	default 0

menuconfig LED_ADVANCED_SETTINGS
	bool "Advanced LED settings"
	default n
	help
	  Advanced options and params for LEDs

if LED_ADVANCED_SETTINGS

config LED_BRIGHTNESS
	int "LED brigthness (0-100)"
	range 0 100
	default 100
config LED_FADE_DURATION_MS
	int "Fade duration (ms)"
	range 0 5000
	default 500

menu "Expert settings"
config LED_DEBUG
	bool "Enable LED debugging"
config LED_DEBUG
	bool "Custom blink pattern"
endmenu

endif #LED_ADVANCED_SETTINGS

endif #LED_SUBSYSTEM


source "Kconfig.zephyr"
